BATCH_DIR=/media/plex/.downloads/torrent-batch
HOST=0.0.0.0
PORT=8787
SHUTDOWN_TIMEOUT=3
MAX_MAP_PEERS=320
MAP_ORIGIN_LABEL=SERVER

# Optional adaptive scheduler for rotational media disks.
ADAPTIVE_CONCURRENCY=false
ADAPTIVE_MIN_CONCURRENCY=1
ADAPTIVE_MAX_CONCURRENCY=4
DISK_WRITE_BUDGET_MIB=35
ADAPTIVE_INGRESS_THRESHOLD=0.75
ADAPTIVE_DISK_BUSY_PERCENT=80
ADAPTIVE_SETTLE_SECONDS=30

# Optional fixed map origin. Leave blank to geolocate the server's public IP.
MAP_ORIGIN_LAT=
MAP_ORIGIN_LON=
MAP_ORIGIN_IP=

MEDIA_ROOT=/media/plex
MOVIES_DIR=/media/plex/Movies
TV_DIR="/media/plex/TV Shows"
DISK_USAGE_PATH=/media/plex

PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=
PLEX_PREFERENCES_PATH="/var/lib/plexmediaserver/Library/Application Support/Plex Media Server/Preferences.xml"
PLEX_MOVIE_SECTION_ID=1
PLEX_SHOW_SECTION_ID=2

MEDIA_CHOWN=
MEDIA_DIR_MODE=775
MEDIA_FILE_MODE=664

# Password auth. Keep AUTH_REQUIRED=true for internet-reachable installs.
# Set this to the exact scheme, host, and port used in the browser.
ORIGIN=https://torplex.example.com
AUTH_REQUIRED=true
AUTH_PASSWORD=replace-with-a-login-password
AUTH_COOKIE_SECRET=replace-with-a-long-random-secret

# Optional Smart Setup. Keep this secret in the runtime environment only.
OPENAI_API_KEY=
TORPLEX_AI_MODEL=gpt-5.6-terra
TORPLEX_AI_EXTRA_INSTRUCTIONS=

# Optional AI-assisted search through administrator-installed qBittorrent Nova plugins.
# Search plugins are executable Python; audit every configured plugin first.
TORPLEX_NOVA_SCRIPT=
TORPLEX_PYTHON=python3
TORPLEX_SEARCH_PLUGINS=
TORPLEX_SEARCH_TIMEOUT_MS=30000
TORPLEX_SEARCH_CONCURRENCY=2

# Optional exact-hash English subtitle provider.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER_AGENT="Torplex v1"
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_TOKEN=

# Comma-separated public IPs to suppress from the swarm map.
IGNORED_PEER_IPS=
